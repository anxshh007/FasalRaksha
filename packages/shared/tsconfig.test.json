{
  // Tests may read the repository (the purity test walks the source tree); the package may not.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "src/testing"]
}
