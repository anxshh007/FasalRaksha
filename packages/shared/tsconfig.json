{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Deliberately no "node" and no "dom": nothing in this package may touch a runtime.
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
