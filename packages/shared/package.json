{
  "name": "@fasal/shared",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "The single implementation of every Fasal Raksha domain rule. Pure TypeScript: zero runtime dependencies, no I/O, deterministic.",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
