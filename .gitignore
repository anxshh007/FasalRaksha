node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# Secrets never enter the repository. .env.example is the only committed env file.
.env
.env.*
!.env.example

# Local PostgreSQL cluster managed by infra/db/local-postgres.mjs
.pgdata/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated at runtime / by tests
data/raw/*
!data/raw/.gitkeep
data/uploads/
playwright-report/
test-results/

# Editor and tooling state, not the product.
.claude/
.vscode/
.idea/

*.log
.DS_Store
Thumbs.db

# Derived by the pipeline from data/raw; reproducible, not committed — except the two reports
# Judge Mode reads at runtime (§14.4), which belong with the release they describe.
data/clean/*
!data/clean/ingest_report.json
!data/clean/validation_report.json

# Intermediate PNG camera scenes; the committed fixtures are the JPEGs made from them.
data/fixtures/camera/png/
