# Copy to .env (gitignored) — or let `pnpm db:start` create it for you.
# No secret has a default anywhere in this codebase: the API refuses to start without them.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
# Strict CORS allowlist: comma-separated origins, no paths, no wildcards.
CORS_ORIGINS=http://localhost:5173

# Least-privilege application role (fasal_app: NOSUPERUSER, NOBYPASSRLS, owns nothing).
# Written by `pnpm db:start` / `pnpm db:bootstrap`.
DATABASE_URL=
# Owner role (fasal_owner), used only by `pnpm db:migrate`.
DATABASE_OWNER_URL=

# docker-compose path only (infra/docker-compose.yml):
POSTGRES_PASSWORD=
DATABASE_SUPERUSER_URL=
DATABASE_NAME=fasal

# Database tests: point at an existing server instead of starting a throwaway embedded one.
TEST_DATABASE_SUPERUSER_URL=
