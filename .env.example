# Copy to .env (gitignored) — or let `pnpm db:start` create it for you.
# No secret has a default anywhere in this codebase: the API refuses to start without them.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
# Strict CORS allowlist: comma-separated origins, no paths, no wildcards.
CORS_ORIGINS=http://localhost:5173

# Least-privilege application role (fasal_app: NOSUPERUSER, NOBYPASSRLS, owns nothing).
# Written by `pnpm db:start` / `pnpm db:bootstrap`.
DATABASE_URL=
# Owner role (fasal_owner), used only by `pnpm db:migrate`.
DATABASE_OWNER_URL=

# docker-compose path only (infra/docker-compose.yml):
POSTGRES_PASSWORD=
DATABASE_SUPERUSER_URL=
DATABASE_NAME=fasal

# Database tests: point at an existing server instead of starting a throwaway embedded one.
TEST_DATABASE_SUPERUSER_URL=

# ── Adapters (PROMPT §3.4): mock | live. Switching is configuration, never code. A live adapter
#    with a missing credential stops the API at boot; it never falls back to the mock silently.
MARKET_ADAPTER=mock
MARKET_API_KEY=
MARKET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_MOCK_FILE=data/raw/agmarknet_synthetic.csv
WEATHER_ADAPTER=mock
REGISTRY_ADAPTER=mock
REGISTRY_GATEWAY_URL=
REGISTRY_GATEWAY_KEY=
MESSAGING_ADAPTER=mock
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
SMS_TEMPLATE_ID=
SPEECH_ADAPTER=mock
BHASHINI_URL=
BHASHINI_KEY=
BHASHINI_SERVICE_IDS=
MODEL_FALLBACK_ADAPTER=mock
ANTHROPIC_API_KEY=
STORAGE_ADAPTER=mock
TRANSPORT_ADAPTER=mock

# Photographs: spool and store (repository-relative or absolute). Served only via signed URLs.
PHOTO_STORE_DIR=data/uploads
LOGISTICS_GATEWAY_URL=
LOGISTICS_GATEWAY_KEY=

# The WhatsApp / SMS / IVR gateway presents this on every inbound webhook (PART XII).
# Unset means those endpoints answer 401: a channel with no shared secret is not a channel.
CHANNEL_SECRET=

# Where the built PWA is, when this process serves it too (apps/web/dist). The app fetches /api
# relatively and its refresh cookie is scoped to /api/auth, so the two belong on one origin;
# see docs/DEPLOY.md. Unset: the API serves only /api.
WEB_DIST_DIR=
